{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "logic-model",
  "type": "object",
  "additionalProperties": false,
  "required": ["logicModelSchemaVersion", "generatorVersion", "scopes", "nodes", "edges", "gaps", "coverage"],
  "properties": {
    "logicModelSchemaVersion": { "const": 2 },
    "generatorVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scopeId", "kind", "title"],
        "properties": {
          "scopeId": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["worktree", "system", "module"] },
          "title": { "type": "string", "minLength": 1 },
          "path": { "type": ["string", "null"], "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._][A-Za-z0-9._/-]*$" },
          "parentScopeId": { "type": ["string", "null"] }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["nodeId", "kind", "scopeId", "title", "status", "sources"],
        "properties": {
          "nodeId": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["page", "dataObject", "field", "requirement", "flow", "state", "permission"] },
          "scopeId": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["original", "adjudicated", "inferred", "recommended-default", "missing"] },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path"],
              "properties": {
                "path": { "type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._][A-Za-z0-9._/-]*$" },
                "anchor": { "type": ["string", "null"] },
                "requirementIds": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-\\d+$" } },
                "oqIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
              }
            }
          },
          "detail": { "type": ["object", "null"] }
        },
        "oneOf": [
          {
            "properties": {
              "kind": { "enum": ["page", "dataObject", "requirement", "state"] }
            }
          },
          {
            "required": ["detail"],
            "properties": {
              "kind": { "const": "flow" },
              "detail": {
                "type": ["object", "null"],
                "properties": {
                  "requiredActions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["purpose", "subject", "action", "permissionRefs", "unauthorizedBehavior"],
                      "properties": {
                        "purpose": { "enum": ["operation", "read", "recovery"] },
                        "subject": { "type": "string", "minLength": 1 },
                        "action": { "type": "string", "minLength": 1 },
                        "permissionRefs": {
                          "type": "array",
                          "items": { "type": "string", "minLength": 1 }
                        },
                        "unauthorizedBehavior": { "type": "string", "minLength": 1 },
                        "handoffRole": { "type": "string", "minLength": 1 }
                      }
                    }
                  },
                  "permissionRefs": {
                    "type": "array",
                    "items": { "type": "string", "minLength": 1 }
                  },
                  "recoveryRequesterRole": { "type": "string", "minLength": 1 },
                  "recoveryRole": { "type": "string", "minLength": 1 },
                  "handoffRole": { "type": "string", "minLength": 1 },
                  "unauthorizedBehavior": { "type": "string", "minLength": 1 }
                }
              }
            }
          },
          {
            "required": ["detail"],
            "properties": {
              "kind": { "const": "field" },
              "detail": {
                "type": "object",
                "required": ["category", "object", "meaning", "type", "required", "example", "exampleRedacted", "declaredSource", "validation", "editable", "exportable", "sensitive"],
                "properties": {
                  "category": { "const": "field" },
                  "object": { "type": "string", "minLength": 1 },
                  "meaning": { "type": "string" },
                  "type": { "type": "string" },
                  "required": { "type": "string" },
                  "example": { "type": ["string", "null"] },
                  "exampleRedacted": { "type": "boolean" },
                  "declaredSource": { "type": "string" },
                  "validation": { "type": "string" },
                  "editable": { "type": "string" },
                  "exportable": { "type": "string" },
                  "sensitive": { "type": "string" }
                }
              }
            }
          },
          {
            "required": ["detail"],
            "properties": {
              "kind": { "const": "permission" },
              "detail": {
                "type": "object",
                "required": ["category", "subject", "action", "rule", "decision"],
                "properties": {
                  "category": { "const": "accessRule" },
                  "subject": { "type": "string", "minLength": 1 },
                  "action": { "type": "string", "minLength": 1 },
                  "rule": { "type": "string", "minLength": 1 },
                  "decision": { "enum": ["allow", "deny", "conditional", "not-applicable"] },
                  "dataScope": { "type": "string", "minLength": 1 },
                  "fieldVisibility": { "type": "string", "minLength": 1 },
                  "denialBehavior": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["edgeId", "kind", "from", "to", "status", "sources"],
        "properties": {
          "edgeId": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["navigates", "reads", "writes", "interacts", "transition", "traces", "owns", "shares"] },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "status": { "enum": ["original", "adjudicated", "inferred", "recommended-default", "missing"] },
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path"],
              "properties": {
                "path": { "type": "string", "pattern": "^(?!.*\\.\\.)[A-Za-z0-9._][A-Za-z0-9._/-]*$" },
                "anchor": { "type": ["string", "null"] },
                "requirementIds": { "type": "array", "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*-\\d+$" } },
                "oqIds": { "type": "array", "items": { "type": "string", "minLength": 1 } }
              }
            }
          },
          "detail": { "type": ["object", "null"] }
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gapId", "scopeId", "kind", "detail"],
        "properties": {
          "gapId": { "type": "string", "minLength": 1 },
          "scopeId": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["missing-section", "missing-relation", "missing-transition", "ambiguous-relation", "interval-traceability", "unparsed", "missing-source"] },
          "detail": { "type": "string", "minLength": 1 },
          "backlogRef": { "type": ["string", "null"] },
          "context": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pageTitle": { "type": ["string", "null"] },
              "flowTitle": { "type": ["string", "null"] },
              "functionTitle": { "type": ["string", "null"] },
              "stepId": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["moduleCount", "pageCount", "fieldCount", "permissionCount", "edgeCount", "requirementCount", "gapCount"],
      "properties": {
        "moduleCount": { "type": "integer", "minimum": 0 },
        "pageCount": { "type": "integer", "minimum": 0 },
        "fieldCount": { "type": "integer", "minimum": 0 },
        "permissionCount": { "type": "integer", "minimum": 0 },
        "flowCount": { "type": "integer", "minimum": 0 },
        "pageStateCount": { "type": "integer", "minimum": 0 },
        "businessStateCount": { "type": "integer", "minimum": 0 },
        "boundaryCount": { "type": "integer", "minimum": 0 },
        "stateImpactCount": { "type": "integer", "minimum": 0 },
        "interactionCount": { "type": "integer", "minimum": 0 },
        "edgeCount": { "type": "integer", "minimum": 0 },
        "requirementCount": { "type": "integer", "minimum": 0 },
        "gapCount": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
